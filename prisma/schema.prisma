generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  ADMIN
  TRAVELLER
  GUIDE
}

enum TrekDifficulty {
  EASY
  MODERATE
  STRENUOUS
  EXTREME
}

enum TrekStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum GuideVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum GuideHireStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentProvider {
  KHALTI
  ESEWA
  STRIPE
}

enum DepartureStatus {
  SCHEDULED
  FULL
  DEPARTED
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REFUNDED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  REJECTED
}

// ============================================================
// USER
// ============================================================

model User {
  id        String   @id @db.Uuid
  email     String   @unique
  fullName  String
  avatarUrl String?
  phone     String?
  role      Role     @default(TRAVELLER)
  isActive  Boolean  @default(true)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guideProfile   GuideProfile?
  guideHiresMade GuideHire[]   @relation("RequesterHires")
  payments       Payment[]
  reviews        Review[]
  trekBookings   TrekBooking[]
  trekPayments   TrekBookingPayment[]

  @@index([email])
  @@index([role])
  @@map("users")
}

// ============================================================
// REGION
// ============================================================

model Region {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  slug      String   @unique
  imageUrl  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  treks Trek[]

  @@map("regions")
}

// ============================================================
// TREK
// ============================================================

model Trek {
  id              String         @id @default(uuid()) @db.Uuid
  regionId        String         @db.Uuid
  title           String
  slug            String         @unique
  description     String
  difficulty      TrekDifficulty
  durationDays    Int
  pricePerPerson  Decimal        @db.Decimal(10, 2)
  maxParticipants Int
  status          TrekStatus     @default(DRAFT)
  coverImageUrl   String?
  deletedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  region     Region             @relation(fields: [regionId], references: [id])
  itinerary  TrekItineraryDay[]
  media      TrekMedia[]
  departures TrekDeparture[]

  @@index([regionId])
  @@index([slug])
  @@index([status])
  @@index([difficulty])
  @@map("treks")
}

// ============================================================
// TREK ITINERARY
// ============================================================

model TrekItineraryDay {
  id          String   @id @default(uuid()) @db.Uuid
  trekId      String   @db.Uuid
  dayNumber   Int
  title       String
  description String
  createdAt   DateTime @default(now())

  trek Trek @relation(fields: [trekId], references: [id], onDelete: Cascade)

  @@unique([trekId, dayNumber])
  @@index([trekId])
  @@map("trek_itinerary_days")
}

// ============================================================
// TREK MEDIA
// ============================================================

model TrekMedia {
  id        String   @id @default(uuid()) @db.Uuid
  trekId    String   @db.Uuid
  url       String
  mediaType String
  caption   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  trek Trek @relation(fields: [trekId], references: [id], onDelete: Cascade)

  @@index([trekId])
  @@map("trek_media")
}

// ============================================================
// GUIDE PROFILE
// ============================================================

model GuideProfile {
  id                 String                  @id @default(uuid()) @db.Uuid
  userId             String                  @unique @db.Uuid
  bio                String?
  experienceYears    Int                     @default(0)
  languages          String[]
  dailyRate          Decimal                 @db.Decimal(10, 2)
  currency           String                  @default("USD")
  specializations    String[]
  licenseNumber      String?
  coverPhotoUrl      String?
  verificationStatus GuideVerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  verifiedById       String?                 @db.Uuid
  rejectionReason    String?
  deletedAt          DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  user           User               @relation(fields: [userId], references: [id])
  hires          GuideHire[]
  reviews        Review[]           @relation("GuideReviews")
  availability   GuideAvailability[]
  payoutRequests PayoutRequest[]

  @@index([verificationStatus])
  @@map("guide_profiles")
}

model GuideAvailability {
  id        String   @id @default(uuid()) @db.Uuid
  guideId   String   @db.Uuid

  startDate DateTime
  endDate   DateTime

  isBlocked Boolean  @default(false) 
  reason    String?

  createdAt DateTime @default(now())

  guide GuideProfile @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@index([guideId])
  @@index([startDate, endDate])
  @@map("guide_availability")
}


// ============================================================
// GUIDE HIRE
// ============================================================

model GuideHire {
  id              String          @id @default(uuid()) @db.Uuid
  requesterId     String          @db.Uuid
  guideId         String          @db.Uuid
  status          GuideHireStatus @default(PENDING)
  startDate       DateTime
  endDate         DateTime
  daysCount       Int
  dailyRate       Decimal         @db.Decimal(10, 2)
  totalAmount     Decimal         @db.Decimal(10, 2)
  currency        String          @default("USD")
  requirements    String?
  rejectionReason String?
  acceptedAt      DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  deletedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  requester User         @relation("RequesterHires", fields: [requesterId], references: [id])
  guide     GuideProfile @relation(fields: [guideId], references: [id])

  payment Payment?
  review  Review?

  @@index([requesterId])
  @@index([guideId])
  @@index([status])
  @@map("guide_hires")
}

// ============================================================
// PAYMENT
// ============================================================

model Payment {
  id                    String          @id @default(uuid()) @db.Uuid
  userId                String          @db.Uuid
  guideHireId           String          @unique @db.Uuid
  amount                Decimal         @db.Decimal(10, 2)
  currency              String          @default("USD")
  status                PaymentStatus   @default(PENDING)
  provider              PaymentProvider
  providerTransactionId String?
  providerMetadata      Json?
  paidAt                DateTime?
  failureReason         String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  user           User           @relation(fields: [userId], references: [id])
  guideHire      GuideHire      @relation(fields: [guideHireId], references: [id])
  payoutRequest  PayoutRequest?

  @@index([userId])
  @@index([status])
  @@map("payments")
}

// ============================================================
// PAYOUT REQUEST
// ============================================================

model PayoutRequest {
  id          String       @id @default(uuid()) @db.Uuid
  guideId     String       @db.Uuid
  paymentId   String       @unique @db.Uuid
  status      PayoutStatus @default(PENDING)
  guideNote   String?
  adminNote   String?
  processedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  guide   GuideProfile @relation(fields: [guideId], references: [id])
  payment Payment      @relation(fields: [paymentId], references: [id])

  @@index([guideId])
  @@index([status])
  @@map("payout_requests")
}

// ============================================================
// REVIEW
// ============================================================

model Review {
  id          String    @id @default(uuid()) @db.Uuid
  reviewerId  String    @db.Uuid
  guideHireId String    @unique @db.Uuid
  guideId     String    @db.Uuid
  rating      Int
  comment     String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())

  reviewer     User         @relation(fields: [reviewerId], references: [id])
  guideProfile GuideProfile @relation("GuideReviews", fields: [guideId], references: [id])
  guideHire    GuideHire    @relation(fields: [guideHireId], references: [id])

  @@index([guideId])
  @@index([reviewerId])
  @@map("reviews")
}

// ============================================================
// TREK DEPARTURE
// ============================================================

model TrekDeparture {
  id              String          @id @default(uuid()) @db.Uuid
  trekId          String          @db.Uuid
  departureDate   DateTime
  returnDate      DateTime?
  pricePerPerson  Decimal         @db.Decimal(10, 2)
  currency        String          @default("USD")
  maxParticipants Int
  status          DepartureStatus @default(SCHEDULED)
  notes                String?
  rescheduledFromId    String?         @db.Uuid
  deletedAt            DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  trek              Trek                 @relation(fields: [trekId], references: [id])
  rescheduledFrom   TrekDeparture?       @relation("DepartureLineage", fields: [rescheduledFromId], references: [id])
  rescheduledInto   TrekDeparture[]      @relation("DepartureLineage")
  bookings          TrekBooking[]
  guides            TrekDepartureGuide[]

  @@index([trekId])
  @@index([departureDate])
  @@index([status])
  @@map("trek_departures")
}

// ============================================================
// TREK BOOKING
// ============================================================

model TrekBooking {
  id          String        @id @default(uuid()) @db.Uuid
  departureId String        @db.Uuid
  userId      String        @db.Uuid
  status      BookingStatus @default(PENDING)
  amount      Decimal       @db.Decimal(10, 2)
  currency    String        @default("USD")
  confirmedAt DateTime?
  cancelledAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  departure TrekDeparture      @relation(fields: [departureId], references: [id])
  user      User               @relation(fields: [userId], references: [id])
  payment   TrekBookingPayment?

  @@unique([departureId, userId])
  @@index([departureId])
  @@index([userId])
  @@index([status])
  @@map("trek_bookings")
}

// ============================================================
// TREK BOOKING PAYMENT
// ============================================================

model TrekBookingPayment {
  id                    String          @id @default(uuid()) @db.Uuid
  bookingId             String          @unique @db.Uuid
  userId                String          @db.Uuid
  amount                Decimal         @db.Decimal(10, 2)
  currency              String          @default("USD")
  status                PaymentStatus   @default(PENDING)
  provider              PaymentProvider
  providerTransactionId String?
  providerMetadata      Json?
  paidAt                DateTime?
  failureReason         String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  booking TrekBooking @relation(fields: [bookingId], references: [id])
  user    User        @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("trek_booking_payments")
}

// ============================================================
// COMPANY GUIDE
// ============================================================

model CompanyGuide {
  id              String    @id @default(uuid()) @db.Uuid
  fullName        String
  email           String?   @unique
  phone           String?
  licenseNumber   String?
  experienceYears Int       @default(0)
  languages       String[]
  specializations String[]
  isActive        Boolean   @default(true)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  assignments TrekDepartureGuide[]

  @@map("company_guides")
}

// ============================================================
// TREK DEPARTURE GUIDE (admin assignment)
// ============================================================

model TrekDepartureGuide {
  id          String   @id @default(uuid()) @db.Uuid
  departureId String   @db.Uuid
  guideId     String   @db.Uuid
  role        String?
  assignedAt  DateTime @default(now())

  departure TrekDeparture @relation(fields: [departureId], references: [id], onDelete: Cascade)
  guide     CompanyGuide  @relation(fields: [guideId], references: [id])

  @@unique([departureId, guideId])
  @@index([departureId])
  @@map("trek_departure_guides")
}
